# Copy this file to signing.properties and keep that file private.
# Paths are resolved from the android/ directory.
storeFile=.signing/reflex7-upload.jks
storePassword=replace-with-a-strong-password
keyAlias=reflex7-upload
keyPassword=replace-with-a-strong-password

# The same values can be supplied without a file through:
# REFLEX7_STORE_FILE, REFLEX7_STORE_PASSWORD,
# REFLEX7_KEY_ALIAS, and REFLEX7_KEY_PASSWORD.
